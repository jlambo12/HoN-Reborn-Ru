	<!-- FS Panels -->
	<panel width="-22w" y="10.2h" align="left" noclick="1" processcursor="1"
		onloadlua="Main:ApplyUltrawideWidth(self, '-22w', '-39.1h')">

		<panel name="fs_parent" noclick="1" processcursor="1">
			<instance name="fs_panel" body="plinko" />
			<instance name="fs_panel" body="game_lobby" />
			<instance name="fs_panel" body="shop" />
			<instance name="fs_panel" body="ladder" processcursor="1" />
			<instance name="fs_panel" body="store" />
			<instance name="fs_panel" body="profile" processcursor="1" />
			<instance name="fs_panel" body="matchstats" processcursor="1" />
			<instance name="fs_panel" body="motd" processcursor="1" />

			<instance name="fs_panel_tabbed"
				body="learn"
				tab1="patch_notes" tab2="tutorial" tab3="hero_list" tab4="itemlist" tab5="boss_info" tab6=""
				tabs="patch_notes:patchnotes_title:/ui/hd_ui/icons/news.tga,tutorial:tutorial_library_list_title:/ui/hd_ui/icons/mentorchat.tga,hero_list:general_hero_list:/ui/hd_ui/icons/ck.tga,itemlist:general_itemlist:/ui/hd_ui/icons/attribute_attack.tga,boss_info:boss_info_title:/ui/hd_ui/icons/phoenix.tga"
			/>

			<instance name="fs_panel_tabbed_extra"
				body="play"
				tab1="matchmaking" tab2="game_list" tab3="" tab4=""
				tabs="matchmaking:ПОИСК МАТЧА,game_list:СВОИ ИГРЫ"
				extra1="ban_list_core"
				object1="BanList_Play"
				extra2="role_pick_core"
				object2="RolePick_Play"
			/>
		</panel>

	</panel>

	<!-- Notification Overlay (after FS Panels so notifications render above matchmaking/lobby) -->
	<panel width="100%" height="-11.8h" y="-5.7h" valign="bottom" noclick="1">
		<panel name="notificationsv2_overlay_anchor" height="50%" x="34h" align="left" valign="bottom" float="right" padding="1h" style="grow_noinvis" noclick="1"
			onloadlua="if NotificationsV2 and NotificationsV2.SyncOverlayToSocialPanel then NotificationsV2:SyncOverlayToSocialPanel() end">
			<instance name="notificationsv2_core" />
		</panel>
	</panel>

