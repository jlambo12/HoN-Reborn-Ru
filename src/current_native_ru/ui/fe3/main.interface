	<!-- Background Effect -->
	<modelpanel name="fe3_background_effect" style="main_background_effect_style"
		model="/core/null/invis.mdf"
		anim="idle"
		effect="/ui/hd_ui/elements/main/bg.effect"
		width="100%" height="100%" align="center"
		onloadlua="if Main:IsUltrawide() then self:SetCameraFov(9) end"
		noclick="1"
	/>

	<!-- Seasonal Ice 
	<image texture="/ui/hd_ui/effects/bg_flame_glow/textures/floor_smoke_white.tga" y="5h" height="25@" hflip="0" color=".95 .95 1 .5" rendermode="additive" noclick="1" />
	<image texture="/ui/hd_ui/effects/bg_flame_glow/textures/floor_smoke_white.tga" y="-5h" vflip="1" valign="bottom" height="25@" color=".95 .95 1 .5" rendermode="additive" noclick="1" />
	-->

	<!-- Faded BG (In Game)-->
	<panel name="fe3_ingame_click_blocker" color="invisible" visible="0" blockinput="1" />
	<panel name="fe3_transparent_blackout" color="0 0 0 0.45"/>

