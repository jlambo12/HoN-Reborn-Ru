<?xml version="1.0" encoding="UTF-8"?>
<interface name="main" noclick="1" alwaysupdate="true" luatable="1" onreloadlua="Main:OnReload()"
	onload="
		If(!VarExists('ui_canCreateGame'), CreateBool('ui_canCreateGame', false));
		CreateBool('_loggedin', false);
		CreateInt('_raceResult', 1);
		CreateBool('_game_lobby_setPotentialAvatar', false);
		CreateString('ui_lastSelectedUser', '');
		CreateString('ui_lastHoveredUser', '');
		CreateString('ui_currentChannel', '');
		SleepWidget(1000,'PlayMusic(\'/music/menu.mp3\',true);');
	"
	onloadlua="
		HoN_Region:Init()
		Lobby:Init()
		KeybindInitializer.Init()
		Main:Init()
		MarketplaceAnnounce:Init()
		Login:Init()
		NotificationsV2:Init()
		ItemList:Init()
		Tutorial:Init()
		Matchmaking:Init()
		HeroInfo:Init()
		LobbyCommunicator:Init()
		BanList_Shared:Init()
		BanList_Play:Init()
		BanList_Lobby:Init()
		RolePick_Shared:Init()
		RolePick_Play:Init()
		RolePick_Lobby:Init()
		Social_Panel:Init()
		SoundManager:Init()
		Social_IM:Init()
		MatchStats:Init()
		Store:Init()
	"
	references="/music/menu.mp3,/music/track_01.mp3,/music/track_02.mp3,/music/track_03.mp3,/music/track_04.mp3,/music/track_05.mp3,/music/track_06.mp3,/music/track_07.mp3,/music/track_08.mp3"
