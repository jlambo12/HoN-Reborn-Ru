	<include file="/ui/fe3/sections/tutorial_npe.package" />

	<!-- Shop Tooltips -->
	<instance name="item_tooltip" id="itemlist_global_item_tooltip" watch="ItemList_GlobalItemTrigger" help="1" />
	<instance name="shop_tip" />

	<!-- Stadium Area (friends list + notifications) — included late so they render above lobby/store/matchmaking/custom-games but stay below dialogs and tooltips. -->
	<include file="/ui/fe3/sections/stadium_area.package" />

	<!-- Bottom-bar selector dropdowns (language + backend). Deliberately above the stadium area as
	     the one exception, so their popup lists open above the friends list / notifications; dialogs
	     and tooltips still render above them. Template defined in bottom_bar.package. -->
	<instance name="bottom_bar_selectors_overlay" />

	<!-- Dialogs / Confirmations -->
	<include file="/ui/fe3/sections/dialogs.package" />

	<!-- Main Generic Tooltips -->
	<include file="/ui/hd_ui/tooltips/tooltip_main.package" />

	<if condition="releaseStage_dev">
		<include file="/ui/dev/autoplay.package" />
		<include file="/ui/fe3/sections/playground.package" />
		<include file="/ui/fe3/sections/playground_3d.package" />
	</if>

	<!-- Disclaimer -->
	<include file="/ui/fe3/sections/disclaimer.package" />

	<!-- Cache Blackout -->
	<include file="/ui/fe3/sections/cache_blackout.package" />

</interface>
